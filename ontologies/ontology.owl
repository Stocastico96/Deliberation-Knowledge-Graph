<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:dcterms="http://purl.org/dc/terms/"
   xmlns:owl="http://www.w3.org/2002/07/owl#"
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
   xmlns:vann="http://purl.org/vocab/vann/"
>
  <rdf:Description rdf:about="https://w3id.org/deliberation/ontology#hasRole">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/deliberation/ontology#Participant"/>
    <rdfs:range rdf:resource="https://w3id.org/deliberation/ontology#Role"/>
    <rdfs:comment>Relates a participant to their role in a deliberation.</rdfs:comment>
    <rdfs:label>has role</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/deliberation/ontology#Contribution">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment>Any input provided by a participant in a deliberation.</rdfs:comment>
    <rdfs:label>Contribution</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/deliberation/ontology#agreeCount">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/deliberation/ontology#Contribution"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:comment>The aggregate number of agreeing reactions to a contribution, as published by the source platform. Use Reaction instances when individual-level reactions are available.</rdfs:comment>
    <rdfs:label>agree count</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/deliberation/ontology#containsFallacy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/deliberation/ontology#Argument"/>
    <rdfs:range rdf:resource="https://w3id.org/deliberation/ontology#FallacyType"/>
    <rdfs:comment>Indicates that an argument contains a specific type of logical fallacy.</rdfs:comment>
    <rdfs:label>contains fallacy</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/deliberation/ontology#CrossPlatformIdentifier">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment>Mechanisms to link entities across different deliberation platforms.</rdfs:comment>
    <rdfs:label>Cross Platform Identifier</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/deliberation/ontology#endDate">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:nodeID="N99633105935a460295e470d5dcf751a8"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    <rdfs:comment>The end date and time of a deliberation process or stage.</rdfs:comment>
    <rdfs:label>end date</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/deliberation/ontology#DeliberationProcess">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment>The overall deliberative activity, including its stages, timeline, and outcomes.</rdfs:comment>
    <rdfs:label>Deliberation Process</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N2bc2b4f138504711859583bfca380c1d">
    <rdf:first rdf:resource="https://w3id.org/deliberation/ontology#Premise"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/deliberation/ontology#takesPlaceIn">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/deliberation/ontology#DeliberationProcess"/>
    <rdfs:range rdf:resource="https://w3id.org/deliberation/ontology#Forum"/>
    <rdfs:comment>Relates a deliberation process to the forum where it takes place.</rdfs:comment>
    <rdfs:label>takes place in</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/deliberation/ontology#hasConclusion">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/deliberation/ontology#Argument"/>
    <rdfs:range rdf:resource="https://w3id.org/deliberation/ontology#Conclusion"/>
    <rdfs:comment>Relates an argument to its conclusion.</rdfs:comment>
    <rdfs:label>has conclusion</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/deliberation/ontology#author">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <owl:equivalentProperty rdf:resource="https://w3id.org/deliberation/ontology#madeBy"/>
    <rdfs:domain rdf:resource="https://w3id.org/deliberation/ontology#Contribution"/>
    <rdfs:range rdf:resource="https://w3id.org/deliberation/ontology#Participant"/>
    <rdfs:comment>Alias of madeBy, retained for compatibility with data already published in the Deliberation Knowledge Graph. New data should prefer madeBy.</rdfs:comment>
    <rdfs:label>author</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/deliberation/ontology#name">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment>The name of an entity.</rdfs:comment>
    <rdfs:label>name</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/deliberation/ontology#InformationResource">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment>External sources of information referenced in deliberations.</rdfs:comment>
    <rdfs:label>Information Resource</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/deliberation/ontology#hasPremise">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/deliberation/ontology#Argument"/>
    <rdfs:range rdf:resource="https://w3id.org/deliberation/ontology#Premise"/>
    <rdfs:comment>Relates an argument to its premises.</rdfs:comment>
    <rdfs:label>has premise</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/deliberation/ontology#Facilitator">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/deliberation/ontology#Role"/>
    <rdfs:comment>The role of hosting, guiding, or moderating a deliberation process. A facilitating entity (an individual, an organization acting as a participant, or an ArtificialAgent) is modeled as a Participant with hasRole pointing to a Facilitator role.</rdfs:comment>
    <rdfs:label>Facilitator</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N99633105935a460295e470d5dcf751a8">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:unionOf rdf:nodeID="N674105f60e57444c8344c432c478e233"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/deliberation/ontology#isAffiliatedWith">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/deliberation/ontology#Participant"/>
    <rdfs:range rdf:resource="https://w3id.org/deliberation/ontology#Organization"/>
    <rdfs:comment>Relates a participant to organizations they are affiliated with.</rdfs:comment>
    <rdfs:label>is affiliated with</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Ne90b9fb94e934491b3da7fbf4b40f8a9">
    <rdf:first rdf:resource="https://w3id.org/deliberation/ontology#Stage"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/deliberation/ontology#startDate">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:nodeID="N6f129c9a8b0449f58c28905d07e1598d"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    <rdfs:comment>The start date and time of a deliberation process or stage.</rdfs:comment>
    <rdfs:label>start date</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/deliberation/ontology#Participant">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment>Individuals or entities taking part in a deliberation process.</rdfs:comment>
    <rdfs:label>Participant</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/deliberation/ontology#reactionType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/deliberation/ontology#Reaction"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment>The kind of reaction (e.g., AGREE, DISAGREE, NEUTRAL, SCORE, QUADRATIC_VOTE).</rdfs:comment>
    <rdfs:label>reaction type</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/deliberation/ontology#supports">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/deliberation/ontology#Argument"/>
    <rdfs:range rdf:nodeID="N2c1b5e3900624c36a5c6219533955460"/>
    <rdfs:comment>Indicates that an argument supports another argument or position.</rdfs:comment>
    <rdfs:label>supports</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/deliberation/ontology#platformIdentifier">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/deliberation/ontology#identifier"/>
    <rdfs:domain rdf:resource="https://w3id.org/deliberation/ontology#CrossPlatformIdentifier"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment>An identifier specific to a particular platform.</rdfs:comment>
    <rdfs:label>platform identifier</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N674105f60e57444c8344c432c478e233">
    <rdf:first rdf:resource="https://w3id.org/deliberation/ontology#DeliberationProcess"/>
    <rdf:rest rdf:nodeID="N9ae0aa7159cf46818a5a01b44f5b93a6"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Ne0b8a7375fca4d749300459c0e3f76f5">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:unionOf rdf:nodeID="N0798c92ef601420292f1ce19569cea36"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/deliberation/ontology#ArgumentStructure">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment>The formal structure of an argument, including premises and conclusions.</rdfs:comment>
    <rdfs:label>Argument Structure</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/deliberation/ontology">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <rdfs:label xml:lang="en">Deliberation Ontology</rdfs:label>
    <rdfs:comment xml:lang="en">A comprehensive model for representing deliberative processes across different platforms and contexts.</rdfs:comment>
    <owl:versionInfo>1.1.0</owl:versionInfo>
    <dcterms:title xml:lang="en">Deliberation Ontology</dcterms:title>
    <dcterms:description xml:lang="en">An ontology for representing and analyzing deliberative processes, arguments, and discourse.</dcterms:description>
    <dcterms:creator>Simone Vagnoni</dcterms:creator>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-03-03</dcterms:created>
    <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-07-23</dcterms:modified>
    <vann:preferredNamespacePrefix>deliberation</vann:preferredNamespacePrefix>
    <vann:preferredNamespaceUri>https://w3id.org/deliberation/ontology#</vann:preferredNamespaceUri>
    <dcterms:license rdf:resource="http://creativecommons.org/licenses/by/4.0/"/>
    <owl:imports rdf:resource="https://w3id.org/deliberation/mappings"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/deliberation/ontology#LegalSource">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/deliberation/ontology#InformationResource"/>
    <rdfs:comment>Legal documents, frameworks, or interpretations relevant to deliberations.</rdfs:comment>
    <rdfs:label>Legal Source</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/deliberation/ontology#reactionValue">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/deliberation/ontology#Reaction"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:comment>The numeric strength of a reaction, where applicable (e.g., a score, or the level of a quadratic vote).</rdfs:comment>
    <rdfs:label>reaction value</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/deliberation/ontology#identifier">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment>A unique identifier for an entity.</rdfs:comment>
    <rdfs:label>identifier</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/deliberation/ontology#country">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/deliberation/ontology#Participant"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment>The country of origin of a participant (ISO 3166-1 alpha-3 code).</rdfs:comment>
    <rdfs:label>country</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/deliberation/ontology#Premise">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/deliberation/ontology#ArgumentStructure"/>
    <rdfs:comment>A statement that provides support for a conclusion in an argument.</rdfs:comment>
    <rdfs:label>Premise</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/deliberation/ontology#Conclusion">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/deliberation/ontology#ArgumentStructure"/>
    <rdfs:comment>The claim that an argument aims to establish.</rdfs:comment>
    <rdfs:label>Conclusion</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/deliberation/ontology#isPartOf">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <owl:inverseOf rdf:resource="https://w3id.org/deliberation/ontology#hasContribution"/>
    <rdfs:domain rdf:resource="https://w3id.org/deliberation/ontology#Contribution"/>
    <rdfs:range rdf:resource="https://w3id.org/deliberation/ontology#DeliberationProcess"/>
    <rdfs:comment>Relates a contribution to the deliberation process it belongs to. Inverse of hasContribution.</rdfs:comment>
    <rdfs:label>is part of</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/deliberation/ontology#url">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/deliberation/ontology#InformationResource"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
    <rdfs:comment>The URL of an information resource.</rdfs:comment>
    <rdfs:label>url</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/deliberation/ontology#hasStage">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/deliberation/ontology#DeliberationProcess"/>
    <rdfs:range rdf:resource="https://w3id.org/deliberation/ontology#Stage"/>
    <rdfs:comment>Relates a deliberation process to its stages.</rdfs:comment>
    <rdfs:label>has stage</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/deliberation/ontology#hasTopic">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/deliberation/ontology#DeliberationProcess"/>
    <rdfs:range rdf:resource="https://w3id.org/deliberation/ontology#Topic"/>
    <rdfs:comment>Relates a deliberation process to its topic.</rdfs:comment>
    <rdfs:label>has topic</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/deliberation/ontology#ArtificialAgent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/deliberation/ontology#Participant"/>
    <rdfs:comment>A non-human participant in a deliberation process, such as an AI system, bot, or algorithm (e.g., a moderation system, a clustering model, or a language model producing summaries). Contributions and classifications produced automatically should be attributed to an ArtificialAgent so that machine-generated content remains distinguishable from human input.</rdfs:comment>
    <rdfs:label>Artificial Agent</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N4e266ec4e2e542f3b20404de6f24a77a">
    <rdf:first rdf:resource="https://w3id.org/deliberation/ontology#Argument"/>
    <rdf:rest rdf:nodeID="Nc81dd142d6f944c0b7e218b0cb18b8a5"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N9ae0aa7159cf46818a5a01b44f5b93a6">
    <rdf:first rdf:resource="https://w3id.org/deliberation/ontology#Stage"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/deliberation/ontology#attacks">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/deliberation/ontology#Argument"/>
    <rdfs:range rdf:nodeID="N59cc15b1774848cab8c9ee2db9085ec8"/>
    <rdfs:comment>Indicates that an argument attacks another argument or position.</rdfs:comment>
    <rdfs:label>attacks</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nd42ab5e694784c6993f2447bd8ad70ed">
    <rdf:first rdf:resource="https://w3id.org/deliberation/ontology#Position"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/deliberation/ontology#Forum">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment>A physical or virtual space where deliberations take place (e.g., digital platform, parliament chamber, court, public square).</rdfs:comment>
    <rdfs:label>Forum</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/deliberation/ontology#responseTo">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/deliberation/ontology#Contribution"/>
    <rdfs:range rdf:resource="https://w3id.org/deliberation/ontology#Contribution"/>
    <rdfs:comment>Relates a contribution to another contribution it responds to.</rdfs:comment>
    <rdfs:label>response to</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N90cba208692e4f0089ef4ccf92c3f50f">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:unionOf rdf:nodeID="Nc8c27cb10e1f4c7a9405828ae61795ec"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/deliberation/ontology#Evidence">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment>Supporting information for claims made in arguments.</rdfs:comment>
    <rdfs:label>Evidence</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/deliberation/ontology#references">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:nodeID="Ne0b8a7375fca4d749300459c0e3f76f5"/>
    <rdfs:range rdf:resource="https://w3id.org/deliberation/ontology#InformationResource"/>
    <rdfs:comment>Relates a contribution or argument to information resources it references.</rdfs:comment>
    <rdfs:label>references</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/deliberation/ontology#hasContribution">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/deliberation/ontology#DeliberationProcess"/>
    <rdfs:range rdf:resource="https://w3id.org/deliberation/ontology#Contribution"/>
    <rdfs:comment>Relates a deliberation process to contributions made within it.</rdfs:comment>
    <rdfs:label>has contribution</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N92cd7da7c8e444b38008b27e7d136b7e">
    <rdf:first rdf:resource="https://w3id.org/deliberation/ontology#Argument"/>
    <rdf:rest rdf:nodeID="Nd42ab5e694784c6993f2447bd8ad70ed"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/deliberation/ontology#madeBy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/deliberation/ontology#Contribution"/>
    <rdfs:range rdf:resource="https://w3id.org/deliberation/ontology#Participant"/>
    <rdfs:comment>Relates a contribution to the participant who made it.</rdfs:comment>
    <rdfs:label>made by</rdfs:label>
  </rdf:Description>
