    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:unionOf rdf:nodeID="N05fe8a9421c344549a77cffec1ac0957"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/deliberation/ontology#hasArgument">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/deliberation/ontology#DeliberationProcess"/>
    <rdfs:range rdf:resource="https://w3id.org/deliberation/ontology#Argument"/>
    <rdfs:comment>Relates a deliberation process to arguments made within it.</rdfs:comment>
    <rdfs:label>has argument</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N2c1b5e3900624c36a5c6219533955460">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:unionOf rdf:nodeID="N4e266ec4e2e542f3b20404de6f24a77a"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/deliberation/ontology#hasParticipant">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/deliberation/ontology#DeliberationProcess"/>
    <rdfs:range rdf:resource="https://w3id.org/deliberation/ontology#Participant"/>
    <rdfs:comment>Relates a deliberation process to its participants.</rdfs:comment>
    <rdfs:label>has participant</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/deliberation/ontology#Reaction">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/deliberation/ontology#Contribution"/>
    <rdfs:comment>A lightweight evaluative contribution made in response to another contribution, such as a vote, rating, or endorsement. The target is expressed with responseTo; the kind and strength of the reaction with reactionType and reactionValue.</rdfs:comment>
    <rdfs:label>Reaction</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/deliberation/ontology#disagreeCount">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/deliberation/ontology#Contribution"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:comment>The aggregate number of disagreeing reactions to a contribution, as published by the source platform. Use Reaction instances when individual-level reactions are available.</rdfs:comment>
    <rdfs:label>disagree count</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/deliberation/ontology#hasEvidence">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:nodeID="N90cba208692e4f0089ef4ccf92c3f50f"/>
    <rdfs:range rdf:resource="https://w3id.org/deliberation/ontology#Evidence"/>
    <rdfs:comment>Relates an argument or premise to supporting evidence.</rdfs:comment>
    <rdfs:label>has evidence</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N59cc15b1774848cab8c9ee2db9085ec8">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:unionOf rdf:nodeID="N92cd7da7c8e444b38008b27e7d136b7e"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/deliberation/ontology#Role">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment>The function or position a participant holds in a deliberation.</rdfs:comment>
    <rdfs:label>Role</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/deliberation/ontology#Organization">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment>Formal entities represented in or responsible for deliberations.</rdfs:comment>
    <rdfs:label>Organization</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/deliberation/ontology#Argument">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/deliberation/ontology#Contribution"/>
    <rdfs:comment>A structured form of contribution with premises and conclusions.</rdfs:comment>
    <rdfs:label>Argument</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/deliberation/ontology#Topic">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment>The subject matter of a deliberation.</rdfs:comment>
    <rdfs:label>Topic</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/deliberation/ontology#FallacyType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment>Classification of logical fallacies that can occur in arguments.</rdfs:comment>
    <rdfs:label>Fallacy Type</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N5548cd756a5545e1bef3bc5f761fba08">
