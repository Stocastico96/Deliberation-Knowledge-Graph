  <rdf:Description rdf:about="https://w3id.org/deliberation/ontology#participantType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/deliberation/ontology#Participant"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment>The type or status of participant (e.g., EU_CITIZEN, NON_EU_CITIZEN, COMPANY, NGO, PUBLIC_AUTHORITY, ACADEMIC_RESEARCH_INSTITUTION).</rdfs:comment>
    <rdfs:label>participant type</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/deliberation/ontology#Consensus">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment>Agreement reached through deliberation.</rdfs:comment>
    <rdfs:label>Consensus</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/deliberation/ontology#Position">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment>A stance or viewpoint on an issue under deliberation.</rdfs:comment>
