{
  "org.deliberation.argument": {
    "defs": {
      "main": {
        "description": "A structured form of contribution with premises and conclusions.",
        "key": "tid",
        "record": {
          "properties": {
            "attacks": {
              "description": "Indicates that an argument attacks another argument or position.",
              "items": {
                "refs": [
                  "org.deliberation.argument",
                  "org.deliberation.position"
                ],
                "type": "union"
              },
              "type": "array"
            },
            "containsFallacy": {
              "description": "Indicates that an argument contains a specific type of logical fallacy.",
              "items": {
                "ref": "org.deliberation.fallacyType",
                "type": "ref"
              },
              "type": "array"
            },
            "hasConclusion": {
              "description": "Relates an argument to its conclusion.",
              "items": {
                "ref": "org.deliberation.conclusion",
                "type": "ref"
              },
              "type": "array"
            },
            "hasEvidence": {
              "description": "Relates an argument or premise to supporting evidence.",
              "items": {
                "ref": "org.deliberation.evidence",
                "type": "ref"
              },
              "type": "array"
            },
            "hasPremise": {
              "description": "Relates an argument to its premises.",
              "items": {
                "ref": "org.deliberation.premise",
                "type": "ref"
              },
              "type": "array"
            },
            "identifier": {
              "description": "A unique identifier for an entity.",
              "maxLength": 200,
              "type": "string"
            },
            "madeBy": {
              "description": "Relates a contribution to the participant who made it.",
              "items": {
                "ref": "org.deliberation.participant",
                "type": "ref"
              },
              "type": "array"
            },
            "name": {
              "description": "The name of an entity.",
              "maxLength": 300,
              "type": "string"
            },
            "references": {
              "description": "Relates a contribution or argument to information resources it references.",
              "items": {
                "ref": "org.deliberation.informationResource",
                "type": "ref"
              },
              "type": "array"
            },
            "responseTo": {
              "description": "Relates a contribution to another contribution it responds to.",
              "items": {
                "ref": "org.deliberation.contribution",
                "type": "ref"
              },
              "type": "array"
            },
            "supports": {
              "description": "Indicates that an argument supports another argument or position.",
              "items": {
                "refs": [
                  "org.deliberation.argument",
                  "org.deliberation.position"
                ],
                "type": "union"
              },
              "type": "array"
            },
            "text": {
              "description": "The textual content of a contribution, argument, position, premise, or conclusion.",
              "maxLength": 10000,
              "minLength": 1,
              "type": "string"
            },
            "timestamp": {
              "description": "The date and time when a contribution was made.",
              "format": "datetime",
              "type": "string"
            }
          },
          "required": [
            "text"
          ],
          "type": "object"
        },
        "type": "record"
      }
    },
    "id": "org.deliberation.argument",
    "lexicon": 1
  },
