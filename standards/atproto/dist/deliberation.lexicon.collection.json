            "name": {
              "description": "The name of an entity.",
              "maxLength": 300,
              "minLength": 1,
              "type": "string"
            },
            "startDate": {
              "description": "The start date and time of a deliberation process or stage.",
              "format": "datetime",
              "type": "string"
            },
            "takesPlaceIn": {
              "description": "Relates a deliberation process to the forum where it takes place.",
              "items": {
                "ref": "org.deliberation.forum",
                "type": "ref"
              },
              "type": "array"
            }
          },
          "required": [
            "name"
          ],
          "type": "object"
        },
        "type": "record"
