ex:proc del:hasContribution ex:vC1 .
ex:vC1 a del:Contribution ; del:text "Under article 32 of the Constitution, article 3 should guarantee free access." ;
    del:references ex:constExpr ; del:aboutProvision ex:art3 ; del:hasAnchor ex:vC1a .
ex:vC1a a del:LegalResourceAnchor ; del:anchorMethod "system_prediction" ; del:anchorProvision ex:constArt32 ; del:anchorExpression ex:constExpr ;
    del:confidence 0.66 ; del:model "synthetic-sbert" ; px:anchorStatus "confirmed" .
